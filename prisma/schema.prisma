generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  FITNESS
  LEARNING
  HEALTH
  PERSONAL_DEVELOPMENT
  OTHER
}

enum CompletionType {
  BOOLEAN
  MEASURABLE
}

enum Recurrence {
  DAILY
  WEEKDAYS
  WEEKLY_TOTAL
}

enum StudySubject {
  DSA
  FDA
  JAVA
  SYSTEM_DESIGN
  CUSTOM
}

// ---- Better Auth core tables ----
model User {
  id                String             @id
  name              String
  email             String             @unique
  username          String?            @unique
  emailVerified     Boolean            @default(false)
  image             String?
  role              String             @default("user")
  banned            Boolean            @default(false)
  banReason         String?
  banExpires        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sessions          Session[]
  accounts          Account[]
  members           Member[]
  invitationsSent   Invitation[]       @relation("InvitationInviter")
  sentRequests      Friendship[]       @relation("FriendshipRequester")
  receivedRequests  Friendship[]       @relation("FriendshipAddressee")
  auditLogs         AuditLog[]         @relation("AuditActor")
  ssoProviders      SsoProvider[]
  settings          UserSettings?
  tasks             Task[]
  logs              TaskLog[]
  pushSubscriptions PushSubscription[]
  achievements      Achievement[]
  coachReviews      CoachReview[]
  createdChallenges Challenge[]            @relation("ChallengeCreator")
  challengeParticipations ChallengeParticipant[]
  readingSessions   UserReadingSession[]
  blogPlans         BlogPlan[]
  integrations      UserIntegration[]
  financeBudgets    FinanceBudget[]
  financeExpenses   FinanceExpense[]
  resumes           UserResume[]
  jobApplications   JobApplication[]
}

model Friendship {
  id          String   @id
  requesterId String
  addresseeId String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  requester   User     @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User     @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@index([requesterId, status])
  @@index([addresseeId, status])
}

model AuditLog {
  id             String       @id @default(cuid())
  timestamp      DateTime     @default(now())
  actorId        String
  organizationId String
  targetUserId   String?
  action         String
  metadata       Json?
  actor          User         @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, timestamp])
  @@index([timestamp])
  @@index([actorId, timestamp])
  @@index([targetUserId, timestamp])
}

model SsoProvider {
  id             String        @id
  issuer         String
  oidcConfig     String?
  samlConfig     String?
  userId         String
  providerId     String        @unique
  organizationId String?
  domain         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([domain])
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  impersonatedBy       String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---- App tables ----
model Organization {
  id           String        @id
  name         String
  slug         String        @unique
  logo         String?
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  members      Member[]
  invitations  Invitation[]
  auditLogs    AuditLog[]
  ssoProviders SsoProvider[]
  challenges   Challenge[]
}

model Member {
  id             String       @id
  organizationId String
  userId         String       @unique
  role           String       @default("member")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
}

model Invitation {
  id             String       @id
  organizationId String
  email          String
  role           String
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

model UserSettings {
  id                String  @id @default(cuid())
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  timezone          String  @default("Asia/Kolkata")
  timezoneSet       Boolean @default(false)
  weekStartsOn      Int     @default(1) // 1 = Monday, 7 = Sunday
  displayName       String?
  showOnLeaderboard Boolean @default(true)
}

model PushSubscription {
  id         String             @id @default(cuid())
  endpoint   String             @unique
  p256dh     String
  auth       String
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())
  deliveries ReminderDelivery[]

  @@index([userId])
}

model ReminderDelivery {
  id             String           @id @default(cuid())
  subscriptionId String
  subscription   PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  localDate      DateTime         @db.Date
  reminderHour   Int
  createdAt      DateTime         @default(now())

  @@unique([subscriptionId, localDate, reminderHour])
}

// Identity + cosmetic fields. Result-affecting rules live in TaskVersion.
model Task {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  category       Category      @default(OTHER)
  personalDevType String?       // "JOB_APPLY" | "DUOLINGO" | "NOVEL_READING" | "BLOG_WRITING" | "CUSTOM"
  isAiGated      Boolean       @default(false)
  aiSubject      StudySubject?
  aiCourseName   String?
  aiCoursePrompt String?
  sortOrder      Int           @default(0)
  startDate      DateTime      @db.Date
  archivedOn     DateTime?     @db.Date // exclusive end: not scheduled on/after this date
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  versions       TaskVersion[]
  logs           TaskLog[]

  @@index([userId, archivedOn])
  @@index([userId, personalDevType])
}

model TaskVersion {
  id             String         @id @default(cuid())
  taskId         String
  task           Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  effectiveFrom  DateTime       @db.Date
  isMandatory    Boolean
  completionType CompletionType
  target         Float          @default(1)
  unit           String?
  recurrence     Recurrence
  weekdays       Int[]
  createdAt      DateTime       @default(now())

  @@unique([taskId, effectiveFrom])
}

model TaskLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Restrict)
  localDate DateTime @db.Date
  value     Float
  updatedAt DateTime @updatedAt

  @@unique([taskId, localDate])
  @@index([userId, localDate])
}

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeType  String
  unlockedAt DateTime @default(now())
  metadata   Json?

  @@unique([userId, badgeType])
  @@index([userId, unlockedAt])
}

model CoachReview {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStartDate DateTime @db.Date
  review        String
  actionableTip String
  createdAt     DateTime @default(now())

  @@unique([userId, weekStartDate])
  @@index([userId, createdAt])
}

enum ChallengeStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model Challenge {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  category       Category?
  unit           String?
  target         Float
  startDate      DateTime               @db.Date
  endDate        DateTime               @db.Date
  status         ChallengeStatus        @default(ACTIVE)
  creatorId      String
  creator        User                   @relation("ChallengeCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  participants   ChallengeParticipant[]

  @@index([organizationId, status])
  @@index([startDate, endDate])
}

model ChallengeParticipant {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())

  @@unique([challengeId, userId])
  @@index([challengeId])
  @@index([userId])
}

enum ReadingSessionStatus {
  READING
  COMPLETED
}

model NovelCatalog {
  id          String               @id @default(cuid())
  externalId  String?              @unique
  title       String
  author      String?
  genre       String?
  coverUrl    String?
  readUrl     String
  description String?
  language    String               @default("en")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  sessions    UserReadingSession[]

  @@index([genre])
  @@index([title])
}

model UserReadingSession {
  id                 String               @id @default(cuid())
  userId             String
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  novelId            String
  novel              NovelCatalog         @relation(fields: [novelId], references: [id], onDelete: Cascade)
  status             ReadingSessionStatus @default(READING)
  currentChapter     Int                  @default(1)
  currentHalf        Int                  @default(1) // 1 = first half of chapter, 2 = second half of chapter
  lastQuizPassedDate String?              // YYYY-MM-DD local date when the daily 3/5 quiz was passed
  startedAt          DateTime             @default(now())
  lastReadAt         DateTime             @default(now())
  completedAt        DateTime?

  @@unique([userId, novelId])
  @@index([userId, status])
  @@index([novelId])
}

model BlogPlan {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic          String
  totalDays      Int
  tone           String           @default("Professional")
  targetAudience String           @default("General")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  days           BlogDayContent[]

  @@index([userId, createdAt])
}

model BlogDayContent {
  id              String   @id @default(cuid())
  planId          String
  plan            BlogPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayNumber       Int
  title           String
  subtopicsJson   Json
  markdownContent String?  @db.Text
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([planId, dayNumber])
  @@index([planId, dayNumber])
}

model UserIntegration {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         String
  externalUsername String
  lastSyncedAt     DateTime?
  lastStatus       String    @default("PENDING")
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, provider])
  @@index([userId, provider])
}

model FinanceBudget {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     String
  monthlyLimit Float
  currency     String   @default("USD")
  monthYear    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, category, monthYear])
  @@index([userId, monthYear])
}

model FinanceExpense {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Float
  category      String
  description   String
  spentAt       DateTime
  paymentMethod String   @default("CARD")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, spentAt])
  @@index([userId, category])
}

model UserResume {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileUrl    String
  parsedText String   @db.Text
  fileData   String?  @db.Text
  mimeType   String?
  skillsJson Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Company {
  id              String           @id @default(cuid())
  name            String
  category        String           // STARTUP, BIG_MNC, BIG_SHARKS, ACTIVELY_HIRING, MID_MNC, SMALL_SCALE, FOREIGN
  hrEmail         String
  websiteUrl      String?
  description        String?
  location           String?
  hiresFromIndia     Boolean          @default(true)
  isIndiaBased       Boolean          @default(false)
  offersRemoteIndia  Boolean          @default(false)
  offersRelocation   Boolean          @default(false)
  atsProvider        String?          // GREENHOUSE, LEVER, ASHBY, REMOTIVE, ARBEITNOW
  atsSlug            String?
  lastRefreshedAt    DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  jobApplications JobApplication[]

  @@index([category, lastRefreshedAt])
  @@index([name])
}

model JobApplication {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobTitle      String
  jobUrl        String?
  jobLocation   String?
  jobDescription String?   @db.Text
  atsMatchScore Int?
  atsBreakdownJson String? @db.Text
  externalJobId String?
  postedAt      DateTime?
  isLiveVerified Boolean  @default(true)
  hrEmail       String
  stage         String    @default("TO_APPLY") // TO_APPLY, WAITING_FU1, FOLLOW_UP_1, WAITING_FU2, FOLLOW_UP_2, WAITING_FU3, FOLLOW_UP_3, REPLIED, CLOSED
  appliedAt     DateTime?
  nextActionAt  DateTime?
  emailThreadId String?
  autoSend      Boolean   @default(false)
  logs          Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, companyId, jobTitle])
  @@index([userId, stage])
  @@index([stage, nextActionAt])
  @@index([userId, createdAt])
}



